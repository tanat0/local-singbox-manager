#!/usr/bin/env bash
set -euo pipefail

prev="${1:-}"
new="${2:-}"

if [[ -z "$prev" || -z "$new" ]]; then
  exit 0
fi

changed="$(git diff --name-only "$prev" "$new" -- requirements.txt pyproject.toml pytest.ini .github/workflows 2>/dev/null || true)"
if [[ -n "$changed" ]]; then
  echo "Dependencies or checks changed:"
  echo "$changed"
  echo "Recommended: make install && make check-fast"
fi
