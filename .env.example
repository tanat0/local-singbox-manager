# === Sing-Box Manager environment ===
# Copy to .env and adjust if needed.

# Paths
SINGBOX_BIN=/usr/bin/sing-box
HELPER_BIN=/usr/local/bin/singbox-manager-helper
DATABASE_URL=sqlite:///./singbox_manager.db

# Auth
# If SINGLE_ADMIN_PASSWORD is empty, the panel is open to local users.
SINGLE_ADMIN_PASSWORD=

# Generate once with: openssl rand -hex 32
# If empty, sessions reset on every app restart.
SESSION_SECRET=

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Tuning
HEALTH_CHECK_INTERVAL=300
