[Unit]
Description=Sing-Box Web Manager
After=network.target

[Service]
Type=simple
User=__SBM_USER__
WorkingDirectory=__SBM_PROJECT_DIR__
EnvironmentFile=-__SBM_PROJECT_DIR__/.env
ExecStart=__SBM_PROJECT_DIR__/.venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port __SBM_PORT__ \
    --log-level info
Restart=on-failure
RestartSec=5
# Never expose to LAN — bind is enforced by --host 127.0.0.1 above
# and additionally blocked here for defence in depth
IPAddressAllow=127.0.0.1/8

[Install]
WantedBy=multi-user.target
